{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Panoptic",
  "version": "0.1.0",
  "identifier": "io.github.panoptic.desktop",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri-front"
  },
  "app": {
    "windows": [
      {
        "title": "Panoptic",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
