{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "backend-ui",
  "description": "UI served by the local backend: database switch only",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:8000/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-check-status",
    "allow-switch-db",
    "allow-show-launcher"
  ]
}
